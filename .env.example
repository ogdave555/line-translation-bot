# LINE Bot Configuration
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
CHANNEL_SECRET=your_line_channel_secret_here

# Claude API Key — used for Claude Sonnet 4.6 (primary model)
CLAUDE_API_KEY=your_claude_api_key_here

# OpenRouter API Key — used for Llama 3.3 70B (fallback model)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter site info for leaderboard attribution
OPENROUTER_SITE_URL=https://your-vercel-app.vercel.app
OPENROUTER_SITE_TITLE=LINE Translation Bot

# Server Configuration (for local development)
PORT=3000
HOST=localhost
