# LINE Bot Configuration
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
CHANNEL_SECRET=your_line_channel_secret_here

# Claude API Key — Anthropic-format key for Claude Sonnet 4.6 (primary model).
# IMPORTANT: this is the Anthropic API key (from https://console.anthropic.com/),
# NOT an OpenRouter key. The webhook sends this to https://api.anthropic.com/v1/messages
# with x-api-key + anthropic-version headers. An OpenRouter key here will be rejected
# with HTTP 401, and the cascade will fall through to the Llama fallback silently.
CLAUDE_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key — used for Llama 3.3 70B (fallback model)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter site info for leaderboard attribution
OPENROUTER_SITE_URL=https://your-vercel-app.vercel.app
OPENROUTER_SITE_TITLE=LINE Translation Bot

# Server Configuration (for local development)
PORT=3000
HOST=localhost
