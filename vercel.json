{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/*",
          "src/core/**",
          "src/translation/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.ts",
      "methods": [
        "GET",
        "POST"
      ]
    }
  ]
}
